{
  "_meta": {
    "description": "Deprecated CPython C APIs that CPython's OWN code still calls. Backs scan_deprecated_apis.py.",
    "verified_against": "CPython main @ 4f3be1b5 (3.16.0a0)",
    "verified_on": "2026-07-24",
    "method": "Every entry was checked against the tree itself: Py_DEPRECATED / _Py_DEPRECATED_EXTERNALLY markers in Include/, `.. deprecated::` / `.. soft-deprecated::` directives in Doc/c-api/, and Doc/deprecations/c-api-pending-removal-in-*.rst. Nothing here is from memory.",
    "tiers": {
      "hard": "Py_DEPRECATED(...) marker in Include/. The compiler warns for external users AND for CPython's own build.",
      "hard-internal": "_Py_DEPRECATED_EXTERNALLY(...) marker. Include/pyport.h:269-274 expands this to NOTHING under Py_BUILD_CORE, so -Wdeprecated-declarations is silent on CPython's own call sites. A scanner is the only way to find these -- this is the highest-value tier.",
      "soft": "Documented as deprecated / soft-deprecated but carrying no compiler marker."
    },
    "severity_rule": "removed_in set -> FIX (the call will stop compiling in that release). Otherwise CONSIDER.",
    "deliberately_excluded": {
      "PyDict_GetItem": "NOT deprecated. Include/dictobject.h:22 is a plain PyAPI_FUNC and Doc/c-api/dict.rst carries only a 'Prefer PyDict_GetItemRef' note -- no .. deprecated:: directive. Discouraged != deprecated.",
      "PyMapping_HasKey": "NOT deprecated. Include/abstract.h:845 plain; Doc/c-api/mapping.rst has a note only.",
      "PyMapping_HasKeyString": "NOT deprecated. Include/abstract.h:838 plain.",
      "PyWeakref_GetObject": "REMOVED in 3.15 (Doc/whatsnew/3.15.rst). Zero occurrences remain; scanning for it finds nothing.",
      "PyEval_CallObject": "REMOVED in 3.13. Likewise PyEval_CallObjectWithKeywords / PyEval_CallFunction / PyEval_CallMethod / PyCFunction_Call.",
      "PyUnicode_GetSize": "REMOVED in 3.12, along with PyUnicode_GET_SIZE / PyUnicode_AsUnicode / PyUnicode_AS_UNICODE.",
      "PyObject_AsCharBuffer": "REMOVED in 3.13, with the rest of the old buffer protocol trio.",
      "Py_TRASHCAN_SAFE_BEGIN": "REMOVED in 3.13.",
      "PyOS_snprintf": "NOT deprecated. Include/pyerrors.h:324 plain; 26 live call sites."
    }
  },
